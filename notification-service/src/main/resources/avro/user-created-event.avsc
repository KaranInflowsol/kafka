{
  "name": "UserCreatedEvent",
  "namespace": "com.codingshuttle.learnKafka.event",
  "type": "record",
  "fields": [
    {
      "name": "id",
      "type": "long",
      "default": 0
    },
    {
      "name": "fullName",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "email",
      "type": ["null", "string"],
      "default": null
    }
  ]
}